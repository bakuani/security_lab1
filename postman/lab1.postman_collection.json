{
  "info": {
    "name": "ITMO Security Lab 1 - personal tasks",
    "description": "Run in order. Fill annaPassword and ivanPassword locally; do not export live tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. No JWT: denied",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/data"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "02. Anna login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"anna\", \"password\": \"{{annaPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.environment.set(\"annaToken\", pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "03. Own tasks and escaped XSS",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{annaToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/data"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test(\"Two own tasks\", () => pm.expect(data.length).to.eql(2));",
              "pm.test(\"XSS escaped\", () => pm.expect(data[1].title).to.include(\"&lt;script&gt;\"));",
              "pm.environment.set(\"annaTaskId\", data[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04. Change status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{annaToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/data/{{annaTaskId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\"status\": \"DONE\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05. Invalid status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{annaToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/data/{{annaTaskId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\"status\": \"INVALID\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "06. SQL injection cannot log in",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"anna' OR '1'='1' --\", \"password\": \"incorrect-demo-password\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "07. Ivan login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"ivan\", \"password\": \"{{ivanPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.environment.set(\"ivanToken\", pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "08. Ivan own task",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ivanToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/data"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test(\"One task\", () => pm.expect(data.length).to.eql(1));",
              "pm.environment.set(\"ivanTaskId\", data[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "09. Anna cannot change Ivan task",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{annaToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/data/{{ivanTaskId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\"status\": \"DONE\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
